pipeline {
    agent any

    environment {
        FE_IMAGE = "pannatronkanla/frontend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/D1n0cute/project-server-less.git'
            }
        }

        // -------------------------------
        // 🔥 CHANGE DETECTION (FIXED)
        // -------------------------------
        stage('Check Frontend Changes') {
            steps {
                script {
                    def changed = sh(
                        script: """
                        git fetch origin main
                        git diff --name-only origin/main...HEAD | grep '^frontend/' || true
                        """,
                        returnStdout: true
                    ).trim()

                    if (!changed) {
                        echo "No frontend changes → skip build"
                        currentBuild.result = 'SUCCESS'
                        return
                    }

                    echo "Frontend changed:\n${changed}"
                }
            }
        }

        // -------------------------------
        // 🧪 TEST STAGE
        // -------------------------------
        stage('Install & Test') {
            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u root'
                }
            }

            steps {
                sh '''
                cd frontend

                if [ -f package-lock.json ]; then
                    npm ci
                else
                    npm install
                fi

                npm run test || echo "No tests or failed tests (ignored)"
                '''
            }
        }

        // -------------------------------
        // 🏗 BUILD DOCKER IMAGE (FIXED)
        // -------------------------------
        stage('Build Docker Image') {
            steps {
                sh '''
                cd frontend
                docker build -t $FE_IMAGE:$TAG .
                '''
            }
        }

        // -------------------------------
        // 📦 PUSH IMAGE (NO latest TAG)
        // -------------------------------
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo $PASS | docker login -u $USER --password-stdin
                    docker push $FE_IMAGE:$TAG
                    '''
                }
            }
        }

        // -------------------------------
        // ☸️ DEPLOY TO K8S (IMPORTANT FIX)
        // -------------------------------
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                kubectl set image deployment/frontend \
                    frontend=$FE_IMAGE:$TAG

                kubectl rollout restart deployment frontend
                kubectl rollout status deployment frontend
                '''
            }
        }

        // -------------------------------
        // 🧹 CLEANUP
        // -------------------------------
        stage('Cleanup') {
            steps {
                sh '''
                docker rmi $FE_IMAGE:$TAG || true
                docker logout || true
                '''
            }
        }
    }
}
