pipeline {
    agent any

    environment {
        FE_IMAGE = "pannatronkanla/frontend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        // -------------------------
        // ✔ Checkout (safe config)
        // -------------------------
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: 'main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/D1n0cute/project-server-less.git'
                    ]],
                    extensions: [[$class: 'CloneOption', shallow: false]]
                ])
            }
        }

        // -------------------------
        // 🧪 TEST (only if frontend changed)
        // -------------------------
        stage('Install & Test') {
            when {
                changeset "frontend/**"
            }

            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u root'
                }
            }

            steps {
                sh '''
                cd frontend

                if [ -f package-lock.json ]; then
                    npm ci
                else
                    npm install
                fi

                npm run test || echo "No tests or test failed (ignored)"
                '''
            }
        }

        // -------------------------
        // 🏗 BUILD (only if frontend changed)
        // -------------------------
        stage('Build Docker Image') {
            when {
                changeset "frontend/**"
            }

            steps {
                sh '''
                cd frontend
                docker build -t $FE_IMAGE:$TAG .
                '''
            }
        }

        // -------------------------
        // 📦 PUSH IMAGE
        // -------------------------
        stage('Push to Docker Hub') {
            when {
                changeset "frontend/**"
            }

            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo $PASS | docker login -u $USER --password-stdin
                    docker push $FE_IMAGE:latest
                    '''
                }
            }
        }



        // -------------------------
        // 🧹 CLEANUP
        // -------------------------
        stage('Cleanup') {
            steps {
                sh '''
                docker image prune -f || true
                docker logout || true
                '''
            }
        }
    }
}
