pipeline {
    agent any

    environment {
        FE_IMAGE = "pannatronkanla/frontend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/D1n0cute/project-server-less.git'
            }
        }

        // 🔥 ตรวจว่า frontend มีการเปลี่ยนไหม
        stage('Check Frontend Changes') {
            steps {
                script {
                    def changed = sh(
                        script: """
                        if git rev-parse HEAD~1 >/dev/null 2>&1; then
                            git diff --name-only HEAD~1 HEAD | grep '^frontend/' || true
                        else
                            echo "first-build"
                        fi
                        """,
                        returnStdout: true
                    ).trim()

                    if (!changed) {
                        currentBuild.result = 'NOT_BUILT'
                        error("❌ No frontend changes → skip pipeline")
                    } else {
                        echo "✅ Frontend changed:\\n${changed}"
                    }
                }
            }
        }

        stage('Install & Test') {
            agent {
                docker {
                    image 'node:20-alpine'
                    args '-u root'
                }
            }
            steps {
                sh '''
                echo "=== Testing Frontend ==="
                cd frontend

                # 🔥 fallback กัน npm ci พัง
                if [ -f package-lock.json ]; then
                    npm ci
                else
                    npm install
                fi

                npm run test || echo "⚠️ no tests or test failed (ignored)"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t $FE_IMAGE:$TAG -t $FE_IMAGE:latest ./frontend
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo $PASS | docker login -u $USER --password-stdin
                    docker push $FE_IMAGE:$TAG
                    docker push $FE_IMAGE:latest
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                echo "Cleaning up Docker images..."

                docker rmi $FE_IMAGE:$TAG || true
                docker rmi $FE_IMAGE:latest || true
                docker logout || true
                '''
            }
        }
    }
}
