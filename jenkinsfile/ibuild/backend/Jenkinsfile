pipeline {
    agent any

    environment {
        BE_IMAGE = "pannatronkanla/backend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/D1n0cute/project-server-less.git'
            }
        }

        // 🔥 ตัวกรองว่า backend มีการเปลี่ยนไหม
        stage('Check Backend Changes') {
            steps {
                script {
                    def changed = sh(
                        script: "git diff --name-only HEAD~1 HEAD | grep '^backend/' || true",
                        returnStdout: true
                    ).trim()

                    if (!changed) {
                        currentBuild.result = 'NOT_BUILT'
                        error("❌ No backend changes → skip pipeline")
                    } else {
                        echo "✅ Backend changed:\n${changed}"
                    }
                }
            }
        }

        stage('Test Backend') {
            steps {
                sh '''
                echo "=== Testing Backend ==="

                cd backend

                python3 -m venv venv
                . venv/bin/activate

                pip install -r requirements.txt
                pytest
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -t $BE_IMAGE:$TAG -t $BE_IMAGE:latest ./backend"
            }
        }

        stage('Push Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo $PASS | docker login -u $USER --password-stdin
                    docker push $BE_IMAGE:$TAG
                    docker push $BE_IMAGE:latest
                    '''
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                echo "Cleaning up Docker images..."

                docker rmi $BE_IMAGE:$TAG || true
                docker rmi $BE_IMAGE:latest || true
                docker logout || true
                '''
            }
        }
    }
}
