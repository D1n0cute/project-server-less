pipeline {
    agent any

    environment {
        BE_IMAGE = "pannatronkanla/backend"
        TAG = "${BUILD_NUMBER}"
    }

    stages {

        // -------------------------
        // ✔ Checkout (ต้องใช้ scm เพื่อให้ changeset ทำงานได้)
        // -------------------------
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // -------------------------
        // 🧪 TEST (backend change only)
        // -------------------------
        stage('Test Backend') {
            when {
                changeset "backend/**"
            }

            steps {
                sh '''
                echo "=== Testing Backend ==="

                cd backend

                if [ -d venv ]; then rm -rf venv; fi

                python3 -m venv venv
                . venv/bin/activate

                pip install --upgrade pip
                pip install -r requirements.txt

                pytest
                '''
            }
        }

        // -------------------------
        // 🏗 BUILD DOCKER IMAGE
        // -------------------------
        stage('Docker Build') {
            when {
                changeset "backend/**"
            }

            steps {
                sh '''
                docker build -t $BE_IMAGE:$TAG ./backend
                '''
            }
        }

        // -------------------------
        // 📦 PUSH IMAGE
        // -------------------------
        stage('Push Docker Hub') {
            when {
                changeset "backend/**"
            }

            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo $PASS | docker login -u $USER --password-stdin
                    docker push $BE_IMAGE:$TAG
                    '''
                }
            }
        }

        // -------------------------
        // 🧹 CLEANUP
        // -------------------------
        stage('Cleanup') {
            steps {
                sh '''
                docker image prune -f || true
                docker logout || true
                '''
            }
        }
    }
}
